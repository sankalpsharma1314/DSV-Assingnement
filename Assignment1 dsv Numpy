        "12.\tCreate an array and demonstrate the difference between a slice/view and a copy."
      ],
      "metadata": {
        "id": "9vD9zH7nHrS2"
      }
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "52b5903d",
        "outputId": "ec0b7f6e-e300-4314-bdf9-bf25a9c33b5a"
      },
      "source": [
        "import numpy as np\n",
        "\n",
        "original_array = np.array([1, 2, 3, 4, 5])\n",
        "print(f\"Original Array: {original_array}\")\n",
        "print(\"\\n\")\n",
        "\n",
        "array_view = original_array[0:3]\n",
        "print(f\"View of the array (first 3 elements): {array_view}\")\n",
        "print(\"\\n\")\n",
        "\n",
        "array_view[0] = 99\n",
        "print(f\"View after modification: {array_view}\")\n",
        "print(f\"Original Array after view modification: {original_array}\")\n",
        "\n",
        "print(\"\\n\")\n",
        "\n",
        "original_array_for_copy = np.array([10, 20, 30, 40, 50])\n",
        "array_copy = original_array_for_copy.copy()\n",
        "print(f\"Original Array for copy: {original_array_for_copy}\")\n",
        "print(f\"Copy of the array: {array_copy}\")\n",
        "\n",
        "array_copy[0] = 1000\n",
        "print(f\"Copy after modification: {array_copy}\")\n",
        "print(f\"Original Array after copy modification: {original_array_for_copy}\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Original Array: [1 2 3 4 5]\n",
            "\n",
            "\n",
            "View of the array (first 3 elements): [1 2 3]\n",
            "\n",
            "\n",
            "View after modification: [99  2  3]\n",
            "Original Array after view modification: [99  2  3  4  5]\n",
            "\n",
            "\n",
            "Original Array for copy: [10 20 30 40 50]\n",
            "Copy of the array: [10 20 30 40 50]\n",
            "Copy after modification: [1000   20   30   40   50]\n",
            "Original Array after copy modification: [10 20 30 40 50]\n"
          ]
        }
      ]
    },
